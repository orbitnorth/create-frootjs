{
  "name": "create-frootjs",
  "version": "1.0.8",
  "description": "Interactive CLI generator for scaffolding high-performance Froot applications",
  "type": "module",
  "bin": {
    "create-frootjs": "dist/index.js",
    "create-froot": "dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js",
    "dev": "node --experimental-strip-types src/index.ts",
    "test": "node --test tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orbitnorth/create-frootjs.git"
  },
  "homepage": "https://github.com/orbitnorth/create-frootjs#readme",
  "bugs": {
    "url": "https://github.com/orbitnorth/create-frootjs/issues"
  },
  "keywords": [
    "froot",
    "frootjs",
    "cli",
    "generator",
    "scaffold",
    "create-froot",
    "create-frootjs",
    "typescript",
    "web",
    "framework"
  ],
  "author": "OrbitNorth LLC",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "frootjs": "link:E:/Business/MetaTools/froot/froot-framework",
    "typescript": "^5.8.0"
  }
}
